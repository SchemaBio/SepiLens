# Generate fresh service tokens and a base64 32-byte encryption key.
SEPILENS_ADDR=127.0.0.1:8080
SEPILENS_DATA_DIR=./data
SEPILENS_AUTH_MODE=required
SEPILENS_PRINCIPALS={"replace-yijian-key":{"tenant":"tenant-a","actor":"yijian","role":"submitter","submit_evidence":true},"replace-reviewer-key":{"tenant":"tenant-a","actor":"reviewer-a","role":"reviewer"},"replace-admin-key":{"tenant":"tenant-a","actor":"ops","role":"admin"}}
SEPILENS_MASTER_KEY_FILE=./secrets/master.key
SEPILENS_RETENTION_DAYS=90
SEPILENS_MAX_EVIDENCE_BYTES=8388608
# Populate from reviewed source versions; empty means no source is trusted.
SEPILENS_SOURCE_POLICIES={}
SEPILENS_ALLOW_PRIVATE_ENDPOINTS=false
# Optional local proxy Fake-IP compatibility, fixed NCBI HTTPS endpoint only.
SEPILENS_RETRIEVAL_ALLOW_FAKE_IP=false
SEPILENS_SIMULATION=false
SEPILENS_LOG_FORMAT=json
SEPILENS_AI_MODE=disabled
# Configure versioned provider profiles through /v2/providers/{profile_id}.
# Medical engine approval is separate from these configuration values.

# Optional signatures for AI evidence organization; formal execution remains gated.
SEPILENS_REQUIRE_RULE_APPROVAL=true
# Optional per-engine evidence-only AI candidates; formal rules remain gated.
SEPILENS_AI_CANDIDATE_ENGINES=
# Reject local evaluations when true.
SEPILENS_AI_ONLY=false

# Bundled HPO vocabulary for AI candidate validation.
SEPILENS_HPO_KNOWLEDGE_DIR=./knowledge/hpo

# Explicit commercial billing for delivered ACMG AI evidence; no rule approval.
SEPILENS_ACMG_BILLING_ENABLED=false

# SVC AI service billing is independent of draft medical-rule approval.
SEPILENS_SVC_BILLING_ENABLED=false

# CNV AI evidence delivery billing; independent of formal rule approval.
SEPILENS_CNV_BILLING_ENABLED=false
