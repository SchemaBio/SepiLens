# Generate a fresh 32-byte key; do not commit the populated .env.
SEPILENS_ADDR=127.0.0.1:8080
SEPILENS_DATA_DIR=./data
SEPILENS_AUTH_MODE=required
# JSON mapping: each token has one tenant, actor and role.
SEPILENS_PRINCIPALS={"replace-submitter-token":{"tenant":"tenant-a","actor":"service-a","role":"submitter"},"replace-reviewer-token":{"tenant":"tenant-a","actor":"reviewer-a","role":"reviewer"},"replace-admin-token":{"tenant":"tenant-a","actor":"administrator-a","role":"admin"}}
# Prefer an ACL-protected mounted file containing base64 of 32 random bytes.
SEPILENS_MASTER_KEY_FILE=./secrets/master.key
SEPILENS_RETENTION_DAYS=90
SEPILENS_ALLOW_PRIVATE_ENDPOINTS=false
SEPILENS_SIMULATION=false
SEPILENS_LOG_FORMAT=json
SEPILENS_KNOWLEDGE_DIR=./knowledge/hpo
# Optional default HPO model. No provider capability is assumed.
SEPILENS_LLM_PROTOCOL=openai_responses
SEPILENS_LLM_BASE_URL=https://api.openai.com/v1
SEPILENS_LLM_MODEL=replace-with-tested-model
# SEPILENS_LLM_API_KEY=
# No clinical engine is enabled by these settings.
## AI assisted assessment remains opt-in and requires approved rules/profile.
SEPILENS_AI_MODE=disabled
