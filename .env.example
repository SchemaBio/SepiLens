# ==========================================
# SepiLens 服务与 LLM 供应商配置文件示例
# 复制本文件为 .env 并放置于二进制同目录下即可生效
# ==========================================

# 1. 服务基础配置
SEPILENS_ADDR=:8080
SEPILENS_DATA_DIR=./data
SEPILENS_AUTH_MODE=disabled
# SEPILENS_API_KEYS=prod-secret:tenant-default
SEPILENS_LOG_FORMAT=text

# 2. 大模型供应商端点配置 (OpenAI / DeepSeek / 通义千问等兼容端点)
SEPILENS_LLM_BASE_URL=https://api.deepseek.com/v1
SEPILENS_LLM_API_KEY=sk-your-llm-api-key-here
SEPILENS_LLM_MODEL=deepseek-chat

# 3. 本地/内网私有化模型 (若端点为 127.0.0.1 或内网 IP，需开启此项)
# SEPILENS_ALLOW_PRIVATE_ENDPOINTS=true
# SEPILENS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SEPILENS_LLM_API_KEY=ollama
# SEPILENS_LLM_MODEL=qwen2.5:14b
